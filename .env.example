# Bind interface; default `::` accepts both address families.
# APP_HOST=::1

# Bind port; default 0 selects and logs an ephemeral port.
# APP_PORT=8080

# Static build output; default `server/templates`.
# APP_TEMPLATES_DIR=server/templates

# Required by a `--features self-signed` build; generate with certgen first.
# APP_TLS_CERT=certs/cert.pem
# APP_TLS_KEY=certs/key.pem

# Required by a `--features acme` build; production defaults false.
# APP_ACME_DOMAINS=example.com
# APP_ACME_EMAIL=admin@example.com
# APP_CERTS_DIR=/certs
# APP_ACME_PRODUCTION=true
